{
  "schema": "samu-strategy/1",
  "name": "Step Basket $10 FINAL",
  "version": "2.0.0",
  "notes": "19 Nov 2026 (Ankush): pehla trade Supertrend ki direction, koi TP nahi. Sabse neeche entry se $5 neeche naya SELL, sabse upar se $5 upar naya BUY. Sirf basket +$10 pe sab close. Basket SL = balance ka 5%. Daily target 1%. Friday 14:00 IST ke baad nayi basket nahi. News time avoid (backtest mein model nahi). Lot (basket ki ginti se): 1–3 = 0.01, 4–6 = 0.02, 7–9 = 0.03, 10–20 = 0.04.",
  "symbol": "XAUUSDm",
  "contract_size": 100,
  "point": 0.001,
  "server_gmt_offset_hours": 0,
  "entry": {
    "type": "supertrend",
    "tf": "M15",
    "atr_period": 10,
    "multiplier": 3,
    "atr_method": "sma",
    "use_closed_bar": true,
    "warmup_bars": 50,
    "open_on": "new_m1_bar",
    "role": "first_trade_direction"
  },
  "first_trade": {
    "tp_price": null,
    "remove_tp_on_second_trade": true,
    "grid_same_side_while_tp": false
  },
  "grid": {
    "step_price": 5,
    "sell_below_lowest": true,
    "buy_above_highest": true,
    "max_trades": 20,
    "after_max": "wait_tp_sl"
  },
  "lots": [
    {
      "from": 1,
      "to": 3,
      "lot": 0.01
    },
    {
      "from": 4,
      "to": 6,
      "lot": 0.02
    },
    {
      "from": 7,
      "to": 9,
      "lot": 0.03
    },
    {
      "from": 10,
      "to": 20,
      "lot": 0.04
    }
  ],
  "basket": {
    "preset": "A",
    "sl_base": "balance_at_basket_start",
    "presets": {
      "A": {
        "tp_usd": 10,
        "sl_pct_balance": 5,
        "trail": null
      },
      "B": {
        "tp_usd": 10,
        "sl_pct_balance": 2,
        "trail": null
      },
      "C": {
        "tp_usd": 20,
        "sl_pct_balance": 5,
        "trail": null
      }
    }
  },
  "daily": {
    "target_pct": 1,
    "loss_pct": 5,
    "base": "day_start_equity",
    "reset_time": "07:00",
    "tz": "IST",
    "on_hit": "close_all_stop_day",
    "open_basket_at_reset": "keep"
  },
  "costs": {
    "commission_per_lot": 0,
    "swap": false
  },
  "filters": {
    "max_spread_points": 0,
    "time": {
      "enabled": false,
      "from": "00:00",
      "to": "23:59",
      "tz": "IST"
    },
    "news": {
      "enabled": true,
      "before_min": 30,
      "after_min": 30
    },
    "friday_stop": {
      "enabled": true,
      "time": "14:00",
      "tz": "IST"
    }
  }
}
